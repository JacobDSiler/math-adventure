{
  "rules": {
    "gameRooms": {
      "$code": {
        ".read": "$code.matches(/^[A-Z]{4}$/)",
        ".write": "$code.matches(/^[A-Z]{4}$/)",
        "meta": {
          ".validate": "newData.hasChildren(['game', 'mode', 'seed'])"
        }
      }
    },
    "gameRoomsByFamily": {
      "$family": {
        ".read": "$family.matches(/^[A-Za-z0-9_-]{3,24}$/)",
        ".write": "$family.matches(/^[A-Za-z0-9_-]{3,24}$/)"
      }
    }
  }
}
